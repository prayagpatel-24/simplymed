# Copy this file to .env and fill it in. Never commit .env to GitHub.

# "mock" works with no key (demo answers). Switch to "gemini" or "groq" once you have a key.
AI_PROVIDER=mock

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# # Free key: https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Websites allowed to call this API (comma-separated). Add your deployed URL later.
ALLOWED_ORIGINS=http://localhost:5173

RATE_LIMIT_PER_MINUTE=10
