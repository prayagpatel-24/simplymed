# Copy to frontend/.env for local accounts. On Vercel, add the same two names under
# Project -> Settings -> Environment Variables.
# Both values are in Supabase -> Project Settings -> API. The anon key is meant to be
# public; Row Level Security (supabase/schema.sql) is what protects each person's data.
# Leave them empty to run in guest mode (no accounts, nothing saved after the tab closes).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only needed if the website and the API are on different addresses (not the case on Vercel).
# VITE_API_URL=
